datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Course {
  id              String      @id @default(uuid())
  slug            String      @unique
  titleFa         String
  titleEn         String
  descriptionFa   String
  instructor      String
  instructorRole  String?     @default("Tech Lead & Educator")
  category        String      @default("برنامه‌نویسی و DevOps")
  level           String      @default("متوسط")
  totalDurationMin Int        @default(0)
  thumbnailUrl    String      @default("https://images.unsplash.com/photo-1618401471353-b98afee0b2eb?w=800&auto=format&fit=crop&q=80")
  badgeText       String?     @default("دوبله اختصاصی AI")
  rating          Float       @default(4.9)
  studentsCount   Int         @default(1240)
  isPublished     Boolean     @default(true)
  chapters        Chapter[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Chapter {
  id          String      @id @default(uuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleFa     String
  orderIndex  Int         @default(1)
  episodes    Episode[]
  createdAt   DateTime    @default(now())
}

model Episode {
  id                  String      @id @default(uuid())
  chapterId           String
  chapter             Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  titleFa             String
  titleEn             String
  episodeNumber       Int         @default(1)
  durationSeconds     Float       @default(0.0)
  streamUrl           String      // Primary proxy stream URL
  originalVideoUrl    String?
  dubbedAudioUrl      String?     // Persian Dubbed Audio Track
  originalAudioUrl    String?     // English Original Audio Track
  subtitleFaUrl       String?     // Persian .vtt subtitle
  subtitleEnUrl       String?     // English .vtt subtitle
  telegramFileId      String?
  telegramMessageId   Int?
  isFreePreview       Boolean     @default(false)
  createdAt           DateTime    @default(now())
}

model DubbingJob {
  id              String      @id
  videoUrl        String
  title           String?
  status          String      @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  progress        Int         @default(0)
  stage           String      @default("در صف انتظار...")
  resultData      String?     // JSON string
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model IngestionBatch {
  id                String      @id @default(uuid())
  sourceUrl         String
  courseTitle       String
  status            String      @default("QUEUED") // QUEUED, DOWNLOADING, EXTRACTING, DUBBING, COMPLETED, FAILED
  totalParts        Int         @default(1)
  totalEpisodes     Int         @default(0)
  completedEpisodes Int         @default(0)
  currentStage      String      @default("آماده‌سازی...")
  voiceGender       String      @default("male")
  logs              String?     // JSON string
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  phone           String?
  name            String
  passwordHash    String?
  role            String      @default("USER") // ADMIN, USER
  isVip           Boolean     @default(false)
  vipExpiresAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  transactions    Transaction[]
}

model SubscriptionPlan {
  id            String        @id @default(uuid())
  title         String
  description   String
  priceToman    Int
  durationDays  Int           @default(30)
  badge         String?
  featuresJson  String        @default("[]")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  transactions  Transaction[]
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          SubscriptionPlan? @relation(fields: [planId], references: [id])
  amountToman   Int
  status        String            @default("PENDING") // PENDING, PAID, FAILED
  authority     String?
  trackingCode  String?
  gateway       String            @default("ZarinPal")
  createdAt     DateTime          @default(now())
}

model GlossaryTerm {
  id            String      @id @default(uuid())
  sourceTerm    String      @unique // e.g. "Kubernetes"
  targetTerm    String      // e.g. "کوبرنتیز (دست‌نخورده)"
  category      String      @default("IT / DevOps")
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

model SystemSetting {
  id            String      @id @default(uuid())
  key           String      @unique // e.g. "GEMINI_API_KEY", "TELEGRAM_BOT_TOKEN"
  value         String
  group         String      @default("GENERAL") // GENERAL, AI, TELEGRAM, SECURITY
  description   String?
  isSecret      Boolean     @default(false)
  updatedAt     DateTime    @updatedAt
}

model Article {
  id            String      @id @default(uuid())
  slug          String      @unique
  title         String
  excerpt       String
  content       String      // Markdown or HTML
  coverImage    String      @default("https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&auto=format&fit=crop&q=80")
  category      String      @default("آموزش هوش مصنوعی")
  author        String      @default("تیم فنی EchoDub")
  readTimeMin   Int         @default(5)
  isPublished   Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SiteBanner {
  id            String      @id @default(uuid())
  type          String      @default("PROMO") // HERO, PROMO, TOP_BAR
  title         String
  subtitle      String?
  badgeText     String?
  linkUrl       String?
  buttonText    String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
}
