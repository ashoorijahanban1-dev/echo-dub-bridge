# ==============================================================================
# EchoDub Bridge (Iran Hub) - Environment Configuration (.env)
# ==============================================================================

# 1. آدرس سرور آمریکا (موتور اصلی دوبله)
US_WORKER_API_URL=http://YOUR_US_SERVER_IP:8000

# 2. اطلاعات وردپرس سایت Downloadly.ir برای درج اتوماتیک پلیر در پست‌ها
WORDPRESS_SITE_URL=https://downloadly.ir
WORDPRESS_REST_USER=admin_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. پورت اجرای سرور ایران
PORT=8080
